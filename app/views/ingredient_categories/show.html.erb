<%# Detalle de un grupo de insumos: sirve tanto para una categoría de Fudo
    (Ingredientes Barra) como para una subcategoría propia (Quesos). %>
<% a = @prices %>
<% g = @group %>
<% suben = @rows.select { |r| r.trend == "alza" } %>
<% bajan = @rows.select { |r| r.trend == "baja" }.sort_by(&:change_pct) %>

<section class="page-head">
  <div>
    <h1><%= @title %></h1>
    <p class="muted">
      <%= @subtitle %> ·
      <%= @rows.size %> insumo<%= "s" if @rows.size != 1 %> ·
      precios netos del <%= a.from.strftime("%d/%m/%Y") %> al <%= a.to.strftime("%d/%m/%Y") %>.
    </p>
  </div>
  <div class="datepicker">
    <form method="get" action="<%= @self_path %>" class="inline">
      <select name="period" onchange="this.form.requestSubmit()">
        <% IngredientPrices::PERIODS.each do |key, label| %>
          <option value="<%= key %>" <%= "selected" if key == a.period_key %>><%= label %></option>
        <% end %>
      </select>
    </form>
    <%= link_to "‹ Volver a insumos", @back_path, class: "btn btn--ghost" %>
  </div>
</section>

<% if @rows.empty? %>
  <section class="card">
    <h2>Sin compras en este período</h2>
    <p class="muted">Prueba con un período más largo.</p>
  </section>
<% else %>

<section class="kpis kpis--6">
  <div class="kpi">
    <div class="kpi__label">Gasto</div>
    <div class="kpi__value"><%= money(g.spend) %></div>
    <div class="kpi__delta muted"><%= number_with_precision(g.share, precision: 1, separator: ",") %>% del total de insumos</div>
  </div>
  <div class="kpi">
    <div class="kpi__label">Variación de precios</div>
    <div class="kpi__value <%= g.change_pct && g.change_pct.positive? ? 'txt--bad' : 'txt--good' %>">
      <%= g.change_pct ? pct_text(100 + g.change_pct, 100) : "—" %>
    </div>
    <div class="kpi__delta muted">
      ponderada por gasto, sobre <%= int(g.reliable_count) %> insumo<%= "s" if g.reliable_count != 1 %>
      <% if g.unreliable_count.positive? %>
        <span title="Quedan fuera las variaciones con menos de <%= IngredientPrices::MIN_CONFIDENCE %> compras en algún extremo: un insumo con dos compras no debe mover el número de toda la categoría">
          (<%= int(g.unreliable_count) %> fuera por pocos datos)
        </span>
      <% end %>
    </div>
  </div>
  <div class="kpi">
    <div class="kpi__label">Subieron</div>
    <div class="kpi__value txt--bad"><%= int(suben.size) %></div>
    <div class="kpi__delta muted"><%= int(bajan.size) %> bajaron</div>
  </div>
  <div class="kpi">
    <div class="kpi__label">Compras</div>
    <div class="kpi__value"><%= int(@rows.sum(&:purchases_count)) %></div>
    <div class="kpi__delta muted">en el período</div>
  </div>
  <div class="kpi">
    <div class="kpi__label">Alertas</div>
    <div class="kpi__value"><%= int(@alerts.size) %></div>
    <div class="kpi__delta muted">saltos de precio avisados</div>
  </div>
  <div class="kpi">
    <%# Mismo criterio que la variación de arriba y que el panel principal:
        solo filas fiables. El cálculo vive en IngredientPrices#build_groups. %>
    <% impacto = g.spend_impact %>
    <div class="kpi__label"><%= impacto.negative? ? "Ahorro" : "Costó de más" %></div>
    <div class="kpi__value <%= impacto.negative? ? 'txt--good' : 'txt--bad' %>"><%= money(impacto.abs) %></div>
    <div class="kpi__delta muted">
      comprando el mismo volumen al precio de ahora en vez del del arranque.
      Solo insumos fiables.
    </div>
  </div>
</section>

<% if @subgroups.any? %>
  <section class="card">
    <h2>Por tipo de insumo</h2>
    <p class="muted small">
      Fudo agrupa todo esto en una sola categoría. Este desglose es el del dashboard,
      y es el que deja ver si lo que se mueve son los quesos o las harinas.
    </p>
    <table class="table">
      <thead>
        <tr><th>Tipo</th><th>Gasto</th><th>% de la categoría</th><th>Variación</th><th>Insumos</th></tr>
      </thead>
      <tbody>
        <% @subgroups.each do |sg| %>
          <tr>
            <td><%= sg.key ? link_to(sg.name, ingredient_category_path(sg.key, period: a.period_key)) : sg.name %></td>
            <td><%= money(sg.spend) %></td>
            <td class="muted"><%= number_with_precision(g.spend.positive? ? sg.spend / g.spend * 100 : 0, precision: 1, separator: ",") %>%</td>
            <td><%= sg.change_pct ? price_change_badge(100 + sg.change_pct, 100) : content_tag(:span, "—", class: "pct pct--na") %></td>
            <td class="muted"><%= int(sg.ingredients_count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if suben.any? %>
  <section class="card card--alert">
    <h2>⚠ Subidas de precio</h2>
    <p class="muted small">
      Comparando la mediana de las primeras compras del período con la de las últimas.
      Ordenado por cuánto pesa la subida sobre el volumen comprado, no por el porcentaje.
    </p>
    <table class="table">
      <thead>
        <tr><th>Insumo</th><th>Antes</th><th>Ahora</th><th>Variación</th><th>Comprado</th><th>Costó de más</th></tr>
      </thead>
      <tbody>
        <% suben.sort_by { |r| -(r.spend_impact || 0) }.each do |r| %>
          <tr>
            <td><%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %>
                <span class="muted small">/ <%= r.unit_label %></span> <%= confidence_note(r) %></td>
            <td><%= money(r.baseline_price) %></td>
            <td><strong><%= money(r.recent_price) %></strong></td>
            <td><%= price_change_badge(r.recent_price, r.baseline_price) %></td>
            <td class="muted"><%= number_with_precision(r.quantity, precision: 1, delimiter: ".", separator: ",") %> <%= r.unit_label %></td>
            <td>
              <%# Ya no hace falta el caso "subió el precio pero el impacto sale
                  negativo": con la fórmula actual el signo del impacto es el de la
                  variación por construcción. Ver IngredientPrices::Row#spend_impact. %>
              <strong><%= money(r.spend_impact) %></strong>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if bajan.any? %>
  <section class="card">
    <h2>Bajaron de precio</h2>
    <table class="table">
      <tr><th>Insumo</th><th>Antes</th><th>Ahora</th><th>Variación</th><th>Ahorro</th></tr>
      <% bajan.each do |r| %>
        <tr>
          <td><%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %> <%= confidence_note(r) %></td>
          <td><%= money(r.baseline_price) %></td>
          <td><strong><%= money(r.recent_price) %></strong></td>
          <td><%= price_change_badge(r.recent_price, r.baseline_price) %></td>
          <td><%= r.spend_impact ? money(r.spend_impact.abs) : "—" %></td>
        </tr>
      <% end %>
    </table>
  </section>
<% end %>

<section class="card">
  <h2>Gasto mes a mes</h2>
  <p class="muted small">Cuánto se compró de este grupo cada mes, en pesos netos.</p>
  <div class="chart">
    <canvas data-controller="chart" data-chart-config-value="<%= { type: 'bar', labels: @monthly[:labels], datasets: [{ label: @title, data: @monthly[:data] }] }.to_json %>"></canvas>
  </div>
</section>

<% if @alerts.any? %>
  <section class="card">
    <h2>Alertas de precio</h2>
    <table class="table">
      <tr><th>Insumo</th><th>Se pagaba</th><th>Esa compra</th><th>Variación</th><th>Costó de más</th><th>Fecha</th></tr>
      <% @alerts.each do |al| %>
        <tr>
          <td><%= link_to al.ingredient_name, ingredient_path(al.fudo_ingredient_id) %>
              <%= alert_suspect_tag(al) %></td>
          <td><%= money(al.baseline_price) %></td>
          <td><strong><%= money(al.new_price) %></strong></td>
          <td><%= price_change_badge(al.new_price.to_f, al.baseline_price.to_f) %></td>
          <td><%= alert_overcost(al) %></td>
          <td class="muted small"><%= al.purchased_on.strftime("%d/%m/%y") %></td>
        </tr>
      <% end %>
    </table>
  </section>
<% end %>

<section class="card">
  <h2>Todos los insumos</h2>
  <%= render "ingredients/mini_table", rows: @rows, period: a.period_key %>
  <p class="small muted" style="text-align:right">
    Total: <strong><%= money(g.spend) %></strong> en <%= int(@rows.sum(&:purchases_count)) %> compras
  </p>
</section>

<% end %>
