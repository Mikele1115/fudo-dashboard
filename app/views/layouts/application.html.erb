<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <title><%= AppSettings.restaurant_name %> — Dashboard de ventas</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍕</text></svg>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Sin sesión no hay barra lateral: la pantalla de entrada va sola y centrada. %>
    <% if authenticated? %>
      <div class="shell">
        <aside class="sidebar">
          <div class="brand">
            <span class="brand__logo" aria-hidden="true">🍕</span>
            <span class="brand__text">
              <span class="brand__name"><%= AppSettings.restaurant_name %></span>
              <span class="brand__sub">Dashboard</span>
            </span>
          </div>

          <nav class="nav">
            <%= link_to root_path, class: ["nav__link", ("nav__link--active" if controller_name == "dashboard")] do %>
              <%= icon(:home) %><span>Dashboard</span>
            <% end %>
            <%= link_to history_path, class: ["nav__link", ("nav__link--active" if controller_name == "history")] do %>
              <%= icon(:history) %><span>Historial</span>
            <% end %>
            <%= link_to ingredients_path, class: ["nav__link", ("nav__link--active" if %w[ingredients ingredient_categories].include?(controller_name))] do %>
              <%= icon(:box) %><span>Insumos</span>
            <% end %>
            <%= link_to products_path, class: ["nav__link", ("nav__link--active" if controller_name == "products")] do %>
              <%= icon(:basket) %><span>Productos</span>
            <% end %>
          </nav>

          <div class="sidebar__foot">
            <%= render "shared/sync_status" %>
            <%= button_to sync_path, params: { date: params[:date] }.compact,
                          class: "btn btn--primary btn--block", form_class: "sidebar__form",
                          disabled: last_sync&.running? do %>
              <%= icon(:refresh, size: 16) %> Sincronizar
            <% end %>
            <div class="sidebar__user">
              <span class="avatar" aria-hidden="true"><%= Current.user.email_address.to_s[0, 1].upcase %></span>
              <span class="sidebar__email"><%= Current.user.email_address %></span>
            </div>
            <%= button_to "Cerrar sesión", session_path, method: :delete,
                          class: "btn btn--ghost btn--block btn--small", form_class: "sidebar__form" %>
          </div>
        </aside>

        <main class="main">
          <%= render "shared/flashes" %>
          <%= yield %>
          <footer class="footer">
            Fuente: Fudo (ventas con estado cerrado). <%= cutoff_note %>
            Zona horaria: <%= AppSettings.timezone_name %>.
          </footer>
        </main>
      </div>
    <% else %>
      <main class="main main--bare">
        <%= render "shared/flashes" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
