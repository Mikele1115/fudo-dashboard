<% r = @report %>
<% p = r.period.current %>
<% lp = r.period.ly %>

<section class="page-head">
  <div>
    <h1><%= month_name(r.month).capitalize %> <%= r.year %></h1>
    <p class="muted">
      <% if r.future? %>Este mes todavía no tiene días completos.
      <% elsif r.complete? %>Mes completo, comparado con <%= month_name(r.month) %> de <%= r.year - 1 %>.
      <% else %>Del 1 al <%= r.to.day %>, comparado con el mismo período de <%= r.year - 1 %>.<% end %>
    </p>
  </div>
  <form class="datepicker" method="get" action="<%= history_path %>">
    <%= link_to "‹", history_path(month: r.prev_month.strftime("%Y-%m")), class: "btn btn--ghost", title: "Mes anterior" %>
    <input type="month" name="month" value="<%= r.from.strftime('%Y-%m') %>" max="<%= AppSettings.report_day.strftime('%Y-%m') %>" onchange="this.form.requestSubmit()">
    <% if r.next_month <= AppSettings.report_day %>
      <%= link_to "›", history_path(month: r.next_month.strftime("%Y-%m")), class: "btn btn--ghost", title: "Mes siguiente" %>
    <% else %>
      <span class="btn btn--ghost btn--disabled">›</span>
    <% end %>
  </form>
</section>

<section class="kpis kpis--6">
  <%= render layout: "shared/kpi", locals: {
        label: "Ventas del mes", value: money(p.total),
        delta: safe_join([pct_badge(p.total, lp.total), " vs. #{money(lp.total)} en #{r.year - 1}"]),
        hint:  "De qué días vive el mes. El día a día de abajo no deja ver que un sábado vale por dos martes." } do %>
    <%= render "history/weekdays", report: r, columna: :venta %>
  <% end %>

  <%= render layout: "shared/kpi", locals: {
        label: "Venta neta (sin IVA)", value: money(p.net),
        delta: safe_join([pct_badge(p.net, lp.net), " vs. #{money(lp.net)}"]),
        hint:  "Qué hay dentro de lo cobrado." } do %>
    <table class="table table--compact">
      <tbody>
        <tr><td>Venta bruta</td><td class="num"><%= money(p.total) %></td></tr>
        <tr><td>IVA incluido (<%= (AppSettings.vat_rate * 100).round %>%)</td>
            <td class="num muted">−<%= money(p.total - p.net) %></td></tr>
        <tr><td><strong>Venta neta</strong></td><td class="num"><strong><%= money(p.net) %></strong></td></tr>
        <tr><td class="muted">Propinas <span class="small">(aparte, no van en la venta)</span></td>
            <td class="num muted"><%= money(p.tips) %></td></tr>
      </tbody>
    </table>
  <% end %>

  <%= render layout: "shared/kpi", locals: {
        label: "Tickets", value: int(p.tickets),
        delta: safe_join([pct_badge(p.tickets, lp.tickets), " vs. #{int(lp.tickets)}"]),
        hint:  "Cuántas mesas y pedidos entran cada día de la semana." } do %>
    <%= render "history/weekdays", report: r, columna: :tickets %>
  <% end %>

  <%= render layout: "shared/kpi", locals: {
        label: "Ticket promedio", value: money(p.avg_ticket),
        delta: safe_join([pct_badge(p.avg_ticket, lp.avg_ticket), " vs. #{money(lp.avg_ticket)}"]),
        hint:  "Qué días tiran del promedio hacia arriba y cuáles hacia abajo." } do %>
    <div class="grid-2">
      <div>
        <h3 class="kpi__subtitle">Ticket más alto</h3>
        <%= render "history/day_list", rows: r.top_days(5, by: :avg_ticket), medida: :avg_ticket %>
      </div>
      <div>
        <h3 class="kpi__subtitle">Ticket más bajo</h3>
        <%= render "history/day_list", rows: r.bottom_days(5, by: :avg_ticket), medida: :avg_ticket %>
      </div>
    </div>
  <% end %>

  <%= render layout: "shared/kpi", locals: {
        label: "Ticket por persona", value: money(p.avg_per_person),
        delta: content_tag(:span, "#{int(p.people)} comensales", class: "muted"),
        hint:  "No es la venta del mes dividida entre los comensales: solo cuentan las ventas de salón donde se registró cuánta gente había." } do %>
    <table class="table table--compact">
      <tbody>
        <tr><td>Venta con comensales registrados</td><td class="num"><%= money(p.people_sales) %></td></tr>
        <tr><td class="muted">Resto del mes <span class="small">(delivery y retiro)</span></td>
            <td class="num muted"><%= money(r.sales_without_people) %></td></tr>
        <tr><td>Comensales</td><td class="num"><%= int(p.people) %></td></tr>
        <tr><td><strong>Ticket por persona</strong></td>
            <td class="num"><strong><%= money(p.avg_per_person) %></strong></td></tr>
      </tbody>
    </table>
    <p class="muted small">
      Dividir toda la venta del mes entre los comensales daría
      <%= money(p.people.positive? ? p.total / p.people : nil) %>, que no es lo que gasta nadie.
    </p>
  <% end %>

  <%= render layout: "shared/kpi", locals: {
        label: "Venta promedio por día",
        value: money(p.days.positive? ? p.total / p.days : nil),
        delta: content_tag(:span, "#{p.days} días con venta de #{r.rows.size}", class: "muted"),
        hint:  "El promedio solo cuenta los días con venta: un día cerrado no baja la media." } do %>
    <div class="grid-2">
      <div>
        <h3 class="kpi__subtitle">Mejores días</h3>
        <%= render "history/day_list", rows: r.top_days(5), medida: :total %>
      </div>
      <div>
        <h3 class="kpi__subtitle">Peores días</h3>
        <%= render "history/day_list", rows: r.bottom_days(5), medida: :total %>
      </div>
    </div>
    <% if r.closed_days.any? %>
      <p class="muted small">
        Sin venta: <%= r.closed_days.map { |d| short_date(d.date) }.join(" · ") %>
      </p>
    <% end %>
  <% end %>
</section>

<section class="card">
  <h2>Día a día</h2>
  <p class="muted"><%= compare_note %> Haz clic en un día para verlo en el dashboard.</p>
  <% if r.empty? %>
    <p class="muted">Sin datos.</p>
  <% else %>
    <table class="table table--rows">
      <thead><tr><th>Día</th><th>Venta bruta</th><th>Venta neta</th><th>Tickets</th><th>Ticket prom.</th><th>Comensales</th><th>Ticket/persona</th><th>Año anterior</th><th>Variación</th></tr></thead>
      <tbody>
        <% r.rows.each do |row| %>
          <tr class="<%= 'is-closed' if row.day && !row.day.open? %>">
            <td><%= link_to short_date(row.date), root_path(date: row.date) %></td>
            <td><%= money(row.day&.total) %></td>
            <td><%= money(row.day&.net) %></td>
            <td><%= int(row.day&.tickets) %></td>
            <td><%= money(row.day&.avg_ticket) %></td>
            <td><%= int(row.day&.people) %></td>
            <td><%= money(row.day&.avg_per_person) %></td>
            <td class="muted"><%= money(row.ly_day&.total) %> <span class="small">(<%= short_date(row.ly_date) %>)</span></td>
            <td><%= pct_badge(row.day&.total, row.ly_day&.total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td>Total</td>
          <td><%= money(p.total) %></td>
          <td><%= money(p.net) %></td>
          <td><%= int(p.tickets) %></td>
          <td><%= money(p.avg_ticket) %></td>
          <td><%= int(p.people) %></td>
          <td><%= money(p.avg_per_person) %></td>
          <td class="muted"><%= money(lp.total) %></td>
          <td><%= pct_badge(p.total, lp.total) %></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
</section>
