<% a = @prices %>

<section class="page-head">
  <div>
    <h1>Insumos</h1>
    <%# El período es el dato que hay que ver de un vistazo: va destacado y solo.
        La letra chica explica cómo se calcula, que se lee una vez y no cada día. %>
    <p class="period">
      <%= a.from.strftime("%d/%m/%Y") %><span class="period__sep">→</span><%= a.to.strftime("%d/%m/%Y") %>
    </p>
    <p class="muted small">
      Precios netos, sin IVA · <%= a.comparison_note %>
    </p>
  </div>
  <%# Ojo: el botón de actualizar va FUERA del formulario del período.
      button_to genera su propio <form>, y un formulario dentro de otro es HTML
      inválido: el navegador ignora el interno y manda el GET del de fuera. %>
  <div class="datepicker">
    <form method="get" action="<%= ingredients_path %>" class="inline">
      <%= hidden_field_tag :sort, @sort %>
      <select name="period" onchange="this.form.requestSubmit()">
        <% IngredientPrices::PERIODS.each do |key, label| %>
          <option value="<%= key %>" <%= "selected" if key == a.period_key %>><%= label %></option>
        <% end %>
      </select>
    </form>
    <%= link_to review_ingredients_path, class: "btn btn--ghost",
                title: "Compras donde el monto cuadra pero la cantidad cargada no" do %>
      Revisar cargas<% if @typos.to_i.positive? %> (<%= int(@typos) %>)<% end %>
    <% end %>
    <%= button_to "Actualizar compras", sync_ingredients_path, params: { period: a.period_key },
                  class: "btn btn--light", form_class: "inline" %>
  </div>
</section>

<% unless a.any? %>
  <section class="card">
    <h2>Todavía no hay compras descargadas</h2>
    <p class="muted">
      Pulsa <strong>Actualizar compras</strong> para traer desde Fudo el historial de compras de insumos.
      La primera descarga trae <%= PurchasesSync::DEFAULT_YEARS %> años y puede tardar un par de minutos.
    </p>
  </section>
<% else %>

<% if @alerts.any? %>
  <section class="card card--alert">
    <h2>⚠ <%= PriceAlert.headline(@alerts) %></h2>
    <p class="muted small">
      Compras que salieron bastante por encima de lo que se venía pagando.
      Solo se avisa de insumos que pesan en el gasto y cuando el sobrecosto supera <%= money(PriceAlertDetector::MIN_OVERCOST) %>.
      <% if @alerts.any?(&:suspect?) %>
        Las marcadas como <strong>revisar carga</strong> no son una subida: el monto coincide al peso con otra
        compra al precio de siempre, así que lo que está mal es la cantidad.
        <%= link_to "Revisar cargas", review_ingredients_path %>.
      <% end %>
    </p>
    <table class="table">
      <tr><th>Insumo</th><th>Se pagaba</th><th>Esta compra</th><th>Variación</th><th>Costó de más</th><th>Fecha</th><th></th></tr>
      <% @alerts.each do |a| %>
        <tr>
          <td><%= link_to a.ingredient_name, ingredient_path(a.fudo_ingredient_id) %>
              <span class="muted small">/ <%= a.unit_label %></span>
              <%= alert_suspect_tag(a) %></td>
          <td><%= money(a.baseline_price) %></td>
          <td><strong><%= money(a.new_price) %></strong></td>
          <td><%= price_change_badge(a.new_price.to_f, a.baseline_price.to_f) %></td>
          <td><strong><%= alert_overcost(a) %></strong></td>
          <td class="muted small"><%= a.purchased_on.strftime("%d/%m/%y") %></td>
          <td><%= button_to "Vista", acknowledge_alert_path(a), class: "btn btn--ghost btn--small", form_class: "inline" %></td>
        </tr>
      <% end %>
    </table>
  </section>
<% end %>

<%# Cada cuadro se abre y enseña de dónde sale su número. Ver _kpi.html.erb. %>
<section class="kpis kpis--5">
  <%= render layout: "kpi", locals: {
        label: "Gasto en insumos", value: money(a.total_spend),
        delta: "#{a.period_label.downcase}, sin IVA",
        hint:  "En qué categorías de Fudo se fue la plata. #{int(a.ingredients_count)} insumos, #{int(a.purchases_count)} compras." } do %>
    <table class="table table--compact">
      <thead><tr><th>Categoría</th><th class="num">Gasto</th><th class="num">Del total</th></tr></thead>
      <tbody>
        <%# Ya viene ordenado de mayor a menor gasto. La ruta es la de categoría de Fudo,
            que va por nombre, igual que en la sección "Por categoría" de más abajo. %>
        <% a.grouped_by_fudo_category.each do |g| %>
          <tr>
            <td><%= link_to g.name, fudo_category_path(g.name, period: a.period_key) %></td>
            <td class="num"><%= money(g.spend) %></td>
            <td class="num muted"><%= number_with_precision(g.share, precision: 1, separator: ",") %>%</td>
          </tr>
        <% end %>
      </tbody>
      <tfoot><tr><th>Total</th><th class="num"><%= money(a.total_spend) %></th><th class="num">100%</th></tr></tfoot>
    </table>
  <% end %>

  <%= render layout: "kpi", locals: {
        label: "La canasta",
        value: a.basket_change_pct ? pct_text(a.basket_change_pct + 100, 100) : "—",
        value_class: a.basket_change_pct.nil? ? "" : (a.basket_change_pct.positive? ? "txt--bad" : "txt--good"),
        delta: "ponderada por gasto, sobre #{int(a.reliable_rows.size)} insumos" +
               (a.unreliable_count.positive? ? " (#{int(a.unreliable_count)} fuera por pocos datos)" : ""),
        hint:  "Cuánto aporta cada insumo al índice. Los puntos suman la canasta: pesa la variación por el gasto, " \
               "para que un insumo de millones mueva más que uno de miles. Quedan fuera las comparaciones con menos " \
               "de #{IngredientPrices::MIN_CONFIDENCE} compras en algún extremo." } do %>
    <% aportes = a.basket_contributions %>
    <% if aportes.empty? %>
      <p class="muted">No hay comparaciones fiables en este período.</p>
    <% else %>
      <table class="table table--compact">
        <thead><tr><th>Insumo</th><th class="num">Gasto</th><th class="num">Variación</th><th class="num">Aporta</th></tr></thead>
        <tbody>
          <% aportes.first(12).each do |row, pp| %>
            <tr>
              <td><%= link_to row.name, ingredient_path(row.ingredient_id) %></td>
              <td class="num muted"><%= money(row.spend) %></td>
              <td class="num"><%= price_change_badge(row.recent_price, row.baseline_price) %></td>
              <td class="num <%= pp.positive? ? 'txt--bad' : 'txt--good' %>"><%= format("%+.2f", pp).tr(".", ",") %> pp</td>
            </tr>
          <% end %>
        </tbody>
        <% if aportes.size > 12 %>
          <tfoot><tr><td colspan="3" class="muted">Otros <%= aportes.size - 12 %> insumos</td>
            <td class="num muted"><%= format("%+.2f", aportes.drop(12).sum { |(_, pp)| pp }).tr(".", ",") %> pp</td></tr></tfoot>
        <% end %>
      </table>
    <% end %>
  <% end %>

  <% impact = a.spend_impact_total %>
  <%= render layout: "kpi", locals: {
        label: impact.negative? ? "Ahorro" : "Costó de más",
        value: money(impact.abs),
        value_class: impact.negative? ? "txt--good" : "txt--bad",
        delta: "comprando el mismo volumen al precio de ahora",
        hint:  "Cantidad comprada x (precio de ahora − precio del arranque), insumo a insumo. " \
               "En verde lo que abarató la cuenta y en rojo lo que la encareció; la suma es el total de arriba. " \
               "Es un «si compraras lo mismo al precio de ahora», no la plata que salió de la caja." } do %>
    <% aportes = a.impact_contributions %>
    <% if aportes.empty? %>
      <p class="muted">No hay comparaciones fiables en este período.</p>
    <% else %>
      <table class="table table--compact">
        <thead><tr><th>Insumo</th><th class="num">Cantidad</th><th class="num">Antes</th><th class="num">Ahora</th><th class="num">Impacto</th></tr></thead>
        <tbody>
          <% aportes.first(12).each do |row, pesos| %>
            <tr>
              <td><%= link_to row.name, ingredient_path(row.ingredient_id) %></td>
              <td class="num muted"><%= number_with_precision(row.quantity, precision: 1, separator: ",", delimiter: ".") %> <%= row.unit_label %></td>
              <td class="num muted"><%= money(row.baseline_price) %></td>
              <td class="num"><%= money(row.recent_price) %></td>
              <td class="num <%= pesos.negative? ? 'txt--good' : 'txt--bad' %>"><%= money(pesos) %></td>
            </tr>
          <% end %>
        </tbody>
        <% if aportes.size > 12 %>
          <tfoot><tr><td colspan="4" class="muted">Otros <%= aportes.size - 12 %> insumos</td>
            <td class="num muted"><%= money(aportes.drop(12).sum { |(_, v)| v }) %></td></tr></tfoot>
        <% end %>
      </table>
    <% end %>
  <% end %>

  <%= render layout: "kpi", locals: {
        label: "Subieron", value: int(a.rising.size),
        delta: "#{int(a.falling.size)} bajaron",
        hint:  "Un insumo cuenta como movido cuando su variación pasa de ±#{number_with_precision(IngredientPrices::STABLE_PCT, precision: 0)}%; " \
               "por debajo se considera precio estable." } do %>
    <div class="grid-2">
      <div>
        <h3 class="kpi__subtitle txt--bad">Subieron (<%= int(a.rising.size) %>)</h3>
        <%= render "ingredients/kpi_moves", rows: a.rising.sort_by { |r| -r.change_pct } %>
      </div>
      <div>
        <h3 class="kpi__subtitle txt--good">Bajaron (<%= int(a.falling.size) %>)</h3>
        <%= render "ingredients/kpi_moves", rows: a.falling.sort_by(&:change_pct) %>
      </div>
    </div>
  <% end %>

  <%= render layout: "kpi", locals: {
        label: "A revisar", value: int(a.suspicious_count),
        delta: "líneas con precio dudoso",
        hint:  "Líneas que no entran en ninguna mediana: o el precio se aleja más de #{IngredientPrices::OUTLIER_FACTOR.round}x " \
               "de lo normal, o el monto cuadra con otra compra y la cantidad no. Su plata sí cuenta en el gasto. " \
               "Se corrigen en Fudo." } do %>
    <% if a.to_review.empty? %>
      <p class="muted">Ninguna línea dudosa en este período.</p>
    <% else %>
      <table class="table table--compact">
        <thead><tr><th>Insumo</th><th class="num">Líneas</th><th class="num">Precio normal</th><th>Última dudosa</th></tr></thead>
        <tbody>
          <% a.to_review.first(12).each do |row| %>
            <% peor = row.suspicious.max_by { |p| p.purchased_on } %>
            <tr>
              <td><%= link_to row.name, ingredient_path(row.ingredient_id) %></td>
              <td class="num"><%= int(row.suspicious_count) %></td>
              <td class="num muted"><%= money(row.median_price) %> / <%= row.unit_label %></td>
              <td class="muted small">
                <%= peor.purchased_on.strftime("%d/%m/%y") %> ·
                <%= number_with_precision(peor.quantity, precision: 2, separator: ",") %> <%= row.unit_label %>
                por <%= money(peor.line_total) %> → <strong><%= money(peor.unit_price) %></strong>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="small"><%= link_to "Revisar cargas", review_ingredients_path %> · las que son error de cantidad traen la cantidad correcta.</p>
    <% end %>
  <% end %>
</section>

<section class="card">
  <div class="card--actions">
    <div>
      <h2>Por categoría</h2>
      <p class="muted small">
        Arriba, tus categorías de Fudo —se sincronizan del POS, no se editan aquí—.
        Dentro, el desglose por tipo de insumo, que Fudo no tiene y es el que deja
        ver si lo que se mueve son los quesos o las harinas.
      </p>
    </div>
    <%= link_to "Editar categorías", ingredient_categories_path, class: "btn btn--light" %>
  </div>

  <% if a.uncategorized.any? %>
    <p class="small">
      <span class="tag tag--warn"><%= a.uncategorized.size %> sin tipo asignado</span>
      <span class="muted">Tienen categoría de Fudo pero no tipo de insumo. <%= link_to "Asignarlos", ingredient_categories_path(filter: "sin") %>.</span>
    </p>
  <% end %>

  <div class="acc__head">
    <span>Categoría / tipo</span><span>Gasto</span><span>% del total</span><span>Variación</span><span>Insumos</span>
  </div>

  <%# <details> nativo: el desplegable funciona sin JavaScript. %>
  <% a.grouped_by_fudo_category.each do |cat| %>
    <details class="acc acc--area">
      <summary class="acc__row">
        <span class="acc__name"><strong><%= cat.name %></strong></span>
        <span><strong><%= money(cat.spend) %></strong></span>
        <span><%= number_with_precision(cat.share, precision: 1, separator: ",") %>%</span>
        <span><%= cat.change_pct ? price_change_badge(100 + cat.change_pct, 100) : content_tag(:span, "—", class: "pct pct--na") %></span>
        <span><%= int(cat.ingredients_count) %></span>
      </summary>

      <div class="acc__body acc__body--tight">
        <p class="small"><%= link_to "Ver #{cat.name} completo, con alertas y gasto mes a mes →", fudo_category_path(cat.name, period: a.period_key) %></p>
      </div>

      <% a.subcategories_of(cat.name).each do |sub| %>
        <details class="acc acc--cat">
          <summary class="acc__row">
            <span class="acc__name"><%= sub.name %></span>
            <span><%= money(sub.spend) %></span>
            <span class="muted"><%= number_with_precision(sub.share, precision: 1, separator: ",") %>%</span>
            <span><%= sub.change_pct ? price_change_badge(100 + sub.change_pct, 100) : content_tag(:span, "—", class: "pct pct--na") %></span>
            <span class="muted"><%= int(sub.ingredients_count) %></span>
          </summary>
          <div class="acc__body">
            <% if sub.key %>
              <p class="small"><%= link_to "Ver #{sub.name.downcase} en detalle, con alertas y gasto mes a mes →", ingredient_category_path(sub.key, period: a.period_key) %></p>
            <% end %>
            <%= render "ingredients/mini_table", rows: sub.rows, period: a.period_key %>
          </div>
        </details>
      <% end %>
    </details>
  <% end %>
</section>

<div class="grid-2">
  <section class="card">
    <h2>Los que más subieron</h2>
    <p class="muted small">Comparando la mediana de las primeras compras del período con la de las últimas.</p>
    <table class="table">
      <tr><th>Insumo</th><th>Antes</th><th>Ahora</th><th>Variación</th></tr>
      <% a.top_rising(6).each do |r| %>
        <tr>
          <td><%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %> <%= confidence_note(r) %></td>
          <td><%= money(r.baseline_price) %></td>
          <td><%= money(r.recent_price) %></td>
          <td><%= price_change_badge(r.recent_price, r.baseline_price) %></td>
        </tr>
      <% end %>
      <% if a.rising.empty? %><tr><td colspan="4" class="muted">Ningún insumo subió de precio en el período.</td></tr><% end %>
    </table>
  </section>

  <section class="card">
    <h2>Los que más bajaron</h2>
    <p class="muted small">Buenas noticias: o negociaste mejor, o cambiaste de proveedor.</p>
    <table class="table">
      <tr><th>Insumo</th><th>Antes</th><th>Ahora</th><th>Variación</th></tr>
      <% a.top_falling(6).each do |r| %>
        <tr>
          <td><%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %> <%= confidence_note(r) %></td>
          <td><%= money(r.baseline_price) %></td>
          <td><%= money(r.recent_price) %></td>
          <td><%= price_change_badge(r.recent_price, r.baseline_price) %></td>
        </tr>
      <% end %>
      <% if a.falling.empty? %><tr><td colspan="4" class="muted">Ningún insumo bajó de precio en el período.</td></tr><% end %>
    </table>
  </section>
</div>

<section class="card">
  <h2>Los que más encarecieron la cuenta</h2>
  <p class="muted small">
    Subida de precio multiplicada por el volumen comprado. Un insumo barato que sube mucho puede dar igual;
    uno caro que sube poco puede costar millones.
  </p>
  <table class="table">
    <tr><th>Insumo</th><th>Variación</th><th>Comprado</th><th>Costó de más</th></tr>
    <% a.costliest_rises(8).each do |r| %>
      <tr>
        <td><%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %></td>
        <td><%= price_change_badge(r.recent_price, r.baseline_price) %></td>
        <td><%= number_with_precision(r.quantity, precision: 1, delimiter: ".", separator: ",") %> <%= r.unit_label %></td>
        <td><strong><%= money(r.spend_impact) %></strong></td>
      </tr>
    <% end %>
    <% if a.costliest_rises(1).empty? %><tr><td colspan="4" class="muted">Nada relevante: los precios no encarecieron la cuenta en este período.</td></tr><% end %>
  </table>
</section>

<section class="card">
  <div class="card--actions">
    <div>
      <h2>Todos los insumos</h2>
      <p class="muted small">Haz clic en un insumo para ver todas sus compras y la evolución de su precio.</p>
    </div>
    <form method="get" action="<%= ingredients_path %>" class="toolbar">
      <%= hidden_field_tag :period, a.period_key %>
      <input type="search" name="q" value="<%= @query %>" placeholder="Buscar insumo…">
      <select name="sort" onchange="this.form.requestSubmit()">
        <option value="rise"   <%= "selected" if @sort == "rise" %>>Mayor subida</option>
        <option value="drop"   <%= "selected" if @sort == "drop" %>>Mayor bajada</option>
        <option value="impact" <%= "selected" if @sort == "impact" %>>Impacto en pesos</option>
        <option value="spend"  <%= "selected" if @sort == "spend" %>>Mayor gasto</option>
        <option value="recent" <%= "selected" if @sort == "recent" %>>Compra más reciente</option>
        <option value="name"   <%= "selected" if @sort == "name" %>>Nombre</option>
      </select>
      <button class="btn btn--light">Filtrar</button>
    </form>
  </div>

  <table class="table table--rows">
    <thead>
      <tr>
        <th>Insumo</th>
        <th>Evolución</th>
        <th>Precio actual</th>
        <th>Antes</th>
        <th>Variación</th>
        <th>Mín. / máx.</th>
        <th>Compras</th>
        <th>Gasto</th>
        <th>Última</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |r| %>
        <tr>
          <td>
            <%= link_to r.name, ingredient_path(r.ingredient_id, period: a.period_key) %>
            <span class="muted small">/ <%= r.unit_label %></span>
            <% if r.suspicious_count.positive? %>
              <span class="tag tag--warn" title="<%= r.suspicious_count %> compra(s) con precio fuera de rango, excluidas del cálculo"><%= r.suspicious_count %> dudosa<%= "s" if r.suspicious_count > 1 %></span>
            <% end %>
          </td>
          <td><%= price_sparkline(r.series) %></td>
          <td><strong><%= money(r.recent_price) %></strong></td>
          <td><%= money(r.baseline_price) %></td>
          <td><%= price_change_badge(r.recent_price, r.baseline_price) %> <%= confidence_note(r) %></td>
          <td class="muted small"><%= money(r.min_price) %> / <%= money(r.max_price) %></td>
          <td><%= int(r.purchases_count) %></td>
          <td><%= money(r.spend) %></td>
          <td class="muted small"><%= r.last_date.strftime("%d/%m/%y") %></td>
        </tr>
      <% end %>
      <% if @rows.empty? %>
        <tr><td colspan="9" class="muted">No hay insumos que coincidan con la búsqueda.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if a.to_review.any? %>
  <section class="card">
    <h2>Compras a revisar en Fudo</h2>
    <p class="muted small">
      Estas líneas tienen un precio unitario muy alejado del habitual del insumo (más de <%= IngredientPrices::OUTLIER_FACTOR.to_i %> veces por encima o por debajo).
      Casi siempre es la cantidad cargada en la unidad equivocada —gramos donde van kilos— o un total en cero.
      Están <strong>excluidas</strong> de todos los cálculos de arriba; corrígelas en Fudo y vuelve a actualizar.
    </p>
    <table class="table">
      <tr><th>Insumo</th><th>Precio habitual</th><th>Fecha</th><th>Cantidad</th><th>Total línea</th><th>Precio unitario</th></tr>
      <% a.to_review.first(12).each do |r| %>
        <% r.suspicious.first(3).each_with_index do |p, i| %>
          <tr>
            <td><%= i.zero? ? link_to(r.name, ingredient_path(r.ingredient_id, period: a.period_key)) : "" %></td>
            <td class="muted"><%= i.zero? ? money(r.median_price) : "" %></td>
            <td><%= p.purchased_on.strftime("%d/%m/%y") %></td>
            <td><%= number_with_precision(p.quantity, precision: 2, delimiter: ".", separator: ",") %> <%= r.unit_label %></td>
            <td><%= money(p.line_total) %></td>
            <td class="pct pct--down"><%= money(p.unit_price) %></td>
          </tr>
        <% end %>
      <% end %>
    </table>
  </section>
<% end %>

<% end %>
