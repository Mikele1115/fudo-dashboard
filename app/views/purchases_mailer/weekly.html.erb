<%# Resumen semanal de compras. CSS en línea: los clientes de correo no cargan hojas externas. %>
<% r  = @r %>
<% th = "padding:8px 6px;border-bottom:2px solid #e5e7eb;font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;text-align:right;" %>
<% td = "padding:8px 6px;border-bottom:1px solid #f0f1f3;" %>
<% tdr = td + "text-align:right;" %>
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title><%= r.subject %></title></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">

  <tr><td style="background:#1f2937;color:#ffffff;padding:20px 28px;">
    <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.75;">🍕 <%= @name %></div>
    <div style="font-size:22px;font-weight:600;margin-top:4px;">Compras de la semana</div>
    <div style="font-size:15px;margin-top:2px;opacity:.9;">
      Del <%= r.from.strftime("%d/%m") %> al <%= r.to.strftime("%d/%m/%Y") %>
    </div>
  </td></tr>

  <% unless r.any? %>
    <tr><td style="padding:28px;">
      <p style="margin:0;color:#6b7280;">No se cargó ninguna compra de insumos esta semana.</p>
    </td></tr>
  <% else %>

  <tr><td style="padding:24px 28px 8px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <% [["Gasto de la semana", money(r.spend)], ["Compras", int(r.count)], ["Insumos", int(r.ingredients_count)]].each do |label, value| %>
        <td width="33%" style="padding:8px;">
          <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:14px 12px;text-align:center;">
            <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;"><%= label %></div>
            <div style="font-size:22px;font-weight:600;margin-top:4px;"><%= value %></div>
          </div>
        </td>
      <% end %>
    </tr></table>
    <p style="margin:8px 8px 0;font-size:13px;color:#6b7280;">
      La semana pasada se gastaron <%= money(r.previous.spend) %>
      <% if r.spend_change_pct %>(<%= price_pct_inline(r.spend, r.previous.spend) %> esta semana)<% end %>.
      Todos los precios son netos, sin IVA.
    </p>
  </td></tr>

  <% if r.alerts.any? %>
    <tr><td style="padding:16px 28px 8px;">
      <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:14px 16px;">
        <div style="font-size:15px;font-weight:600;color:#92400e;margin-bottom:6px;">
          ⚠ <%= r.alerts.size %> alerta<%= "s" if r.alerts.size > 1 %> de precio esta semana
        </div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
          <% r.alerts.each do |a| %>
            <tr>
              <td style="<%= td %>"><%= a.ingredient_name %> <span style="color:#6b7280;font-size:12px;">/ <%= a.unit_label %></span></td>
              <td style="<%= tdr %>"><%= money(a.baseline_price) %> → <strong><%= money(a.new_price) %></strong></td>
              <td style="<%= tdr %>"><%= price_pct_inline(a.new_price.to_f, a.baseline_price.to_f) %></td>
              <td style="<%= tdr %>">costó <strong><%= money(a.overcost) %></strong> de más</td>
            </tr>
          <% end %>
        </table>
      </div>
    </td></tr>
  <% end %>

  <% if r.by_area.size > 1 %>
    <tr><td style="padding:16px 28px 8px;">
      <div style="font-size:15px;font-weight:600;margin-bottom:8px;">Por categoría</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
        <tr>
          <th style="<%= th %>text-align:left;">Categoría</th>
          <th style="<%= th %>">Esta semana</th>
          <th style="<%= th %>">% del total</th>
          <th style="<%= th %>">Semana anterior</th>
          <th style="<%= th %>">Variación</th>
        </tr>
        <% r.by_area.each do |a| %>
          <tr>
            <td style="<%= td %>"><%= a[:area] %></td>
            <td style="<%= tdr %>"><strong><%= money(a[:spend]) %></strong></td>
            <td style="<%= tdr %>"><%= number_with_precision(a[:share], precision: 1, separator: ",") %>%</td>
            <td style="<%= tdr %>"><%= money(a[:previous]) %></td>
            <td style="<%= tdr %>"><%= a[:previous].positive? ? price_pct_inline(a[:spend], a[:previous]) : "—" %></td>
          </tr>
        <% end %>
      </table>
    </td></tr>
  <% end %>

  <tr><td style="padding:16px 28px 8px;">
    <div style="font-size:15px;font-weight:600;margin-bottom:8px;">En qué se fue la plata</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
      <tr>
        <th style="<%= th %>text-align:left;">Insumo</th>
        <th style="<%= th %>">Cantidad</th>
        <th style="<%= th %>">Precio</th>
        <th style="<%= th %>">vs. antes</th>
        <th style="<%= th %>">Gasto</th>
      </tr>
      <% r.top_spend(12).each do |l| %>
        <tr>
          <td style="<%= td %>"><%= l.name %> <span style="color:#6b7280;font-size:12px;">/ <%= l.unit_label %></span></td>
          <td style="<%= tdr %>"><%= number_with_precision(l.quantity, precision: 1, delimiter: ".", separator: ",") %></td>
          <td style="<%= tdr %>"><%= money(l.last_price) %></td>
          <td style="<%= tdr %>"><%= l.change_pct ? price_pct_inline(l.last_price, l.prev_price) : "—" %></td>
          <td style="<%= tdr %>"><strong><%= money(l.spend) %></strong></td>
        </tr>
      <% end %>
    </table>
  </td></tr>

  <% if r.rising.any? %>
    <tr><td style="padding:16px 28px 8px;">
      <div style="font-size:15px;font-weight:600;margin-bottom:4px;">Subieron de precio</div>
      <div style="font-size:12px;color:#6b7280;margin-bottom:8px;">Comparado con el último precio pagado antes de esta semana.</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
        <% r.rising(8).each do |l| %>
          <tr>
            <td style="<%= td %>"><%= l.name %></td>
            <td style="<%= tdr %>"><%= money(l.prev_price) %> → <strong><%= money(l.last_price) %></strong></td>
            <td style="<%= tdr %>"><%= price_pct_inline(l.last_price, l.prev_price) %></td>
          </tr>
        <% end %>
      </table>
    </td></tr>
  <% end %>

  <% if r.falling.any? %>
    <tr><td style="padding:8px 28px;">
      <div style="font-size:15px;font-weight:600;margin-bottom:8px;">Bajaron de precio</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
        <% r.falling.each do |l| %>
          <tr>
            <td style="<%= td %>"><%= l.name %></td>
            <td style="<%= tdr %>"><%= money(l.prev_price) %> → <strong><%= money(l.last_price) %></strong></td>
            <td style="<%= tdr %>"><%= price_pct_inline(l.last_price, l.prev_price) %></td>
          </tr>
        <% end %>
      </table>
    </td></tr>
  <% end %>

  <% if r.first_time.any? %>
    <tr><td style="padding:16px 28px 8px;">
      <div style="font-size:15px;font-weight:600;margin-bottom:8px;">Comprados por primera vez</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
        <% r.first_time.first(8).each do |l| %>
          <tr>
            <td style="<%= td %>"><%= l.name %> <span style="color:#6b7280;font-size:12px;">/ <%= l.unit_label %></span></td>
            <td style="<%= tdr %>"><%= money(l.last_price) %></td>
            <td style="<%= tdr %>"><%= money(l.spend) %></td>
          </tr>
        <% end %>
      </table>
    </td></tr>
  <% end %>

  <% if r.suspicious.any? %>
    <tr><td style="padding:16px 28px 8px;">
      <div style="font-size:15px;font-weight:600;margin-bottom:4px;">A revisar en Fudo</div>
      <div style="font-size:12px;color:#6b7280;margin-bottom:8px;">
        Líneas cargadas esta semana con un precio unitario muy fuera de lo normal.
        Suele ser la cantidad en la unidad equivocada o un total en cero. No entran en ningún cálculo.
      </div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
        <% r.suspicious.first(10).each do |p| %>
          <tr>
            <td style="<%= td %>"><%= p.ingredient_name %></td>
            <td style="<%= tdr %>"><%= p.purchased_on.strftime("%d/%m") %></td>
            <td style="<%= tdr %>"><%= number_with_precision(p.quantity, precision: 2, delimiter: ".", separator: ",") %> <%= p.unit_name %></td>
            <td style="<%= tdr %>"><%= money(p.line_total) %></td>
            <td style="<%= tdr %>;color:#b91c1c;"><%= money(p.unit_price) %> / <%= p.unit_name %></td>
          </tr>
        <% end %>
      </table>
    </td></tr>
  <% end %>

  <% end %>

  <tr><td style="padding:16px 28px 24px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
    Fuente: Fudo (egresos con detalle de insumos). Precios netos, sin IVA.
    Generado el <%= Time.current.in_time_zone(AppSettings.timezone_name).strftime("%d/%m/%Y %H:%M") %>.
  </td></tr>

</table>
</td></tr></table>
</body></html>
