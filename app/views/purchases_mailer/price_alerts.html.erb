<%# Aviso de saltos de precio. CSS en línea: los clientes de correo no cargan hojas externas. %>
<% td = "padding:8px 6px;border-bottom:1px solid #f0f1f3;" %>
<% tdr = td + "text-align:right;" %>
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title>Alerta de precios</title></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">

  <tr><td style="background:#92400e;color:#ffffff;padding:20px 28px;">
    <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.8;">🍕 <%= @name %></div>
    <div style="font-size:22px;font-weight:600;margin-top:4px;">
      <%= PriceAlert.headline(@alerts) %>
    </div>
  </td></tr>

  <tr><td style="padding:20px 28px 8px;">
    <% sobrecosto = @alerts.sum(&:real_overcost) %>
    <% cargas = @alerts.select(&:suspect?) %>
    <%# Corto a propósito: cada compra trae debajo su propia explicación, al lado de los
        números que la sostienen. Repetirla aquí arriba y otra vez en el pie —como estaba—
        era decir lo mismo tres veces. %>
    <p style="margin:0 0 14px;color:#374151;">
      <% if sobrecosto.positive? %>
        <strong><%= money(sobrecosto) %></strong> de sobrecosto.
      <% end %>
      <% if cargas.any? %>
        <%= cargas.size == 1 ? "Una compra no subió de precio" : "#{cargas.size} compras no subieron de precio" %>:
        la cantidad está mal cargada.
        <a href="<%= review_ingredients_url %>" style="color:#92400e;">Revisar cargas</a>.
      <% end %>
    </p>

    <% @alerts.each do |a| %>
      <div style="border:1px solid #e5e7eb;border-left:4px solid <%= a.suspect? ? "#d97706" : "#b91c1c" %>;border-radius:6px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:16px;font-weight:600;"><%= a.ingredient_name %>
          <% if a.key_ingredient? %>
            <span style="font-size:11px;font-weight:600;color:#1e40af;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:2px 8px;vertical-align:middle;">insumo clave</span>
          <% end %>
          <% if a.suspect? %>
            <span style="font-size:11px;font-weight:600;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:2px 8px;vertical-align:middle;">revisar carga</span>
          <% end %>
        </div>
        <div style="font-size:13px;color:#6b7280;margin-bottom:8px;">
          Comprado el <%= a.purchased_on.strftime("%d/%m/%Y") %>
          <% if a.provider_name.present? %>a <%= a.provider_name %><% end %>
        </div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
          <tr>
            <td style="<%= td %>color:#6b7280;">Se venía pagando</td>
            <td style="<%= tdr %>"><%= money(a.baseline_price) %> / <%= a.unit_label %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Esta compra</td>
            <td style="<%= tdr %>"><strong><%= money(a.new_price) %> / <%= a.unit_label %></strong>
              <%= price_pct_inline(a.new_price.to_f, a.baseline_price.to_f) %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Cantidad comprada</td>
            <td style="<%= tdr %>"><%= number_with_precision(a.quantity, precision: 2, delimiter: ".", separator: ",") %> <%= a.unit_label %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Monto de la compra</td>
            <td style="<%= tdr %>"><%= money(a.new_price.to_f * a.quantity.to_f) %></td>
          </tr>
          <% if a.suspect? %>
            <tr>
              <td style="<%= td %>color:#6b7280;">Ese mismo monto</td>
              <td style="<%= tdr %>color:#92400e;font-weight:600;">
                <% if a.twin_purchased_on.present? %>
                  ya se pagó el <%= a.twin_purchased_on.strftime("%d/%m/%Y") %>
                  por <%= number_with_precision(a.twin_quantity, precision: 2, delimiter: ".", separator: ",") %> <%= a.unit_label %>
                <% else %>
                  coincide con otra compra al precio habitual
                <% end %>
              </td>
            </tr>
            <tr>
              <td colspan="2" style="<%= td %>color:#92400e;">
                El precio no subió: salió la misma plata. Lo que hay que corregir en Fudo es la cantidad.
              </td>
            </tr>
          <% else %>
            <tr>
              <td style="<%= td %>color:#6b7280;">Costó de más</td>
              <td style="<%= tdr %>color:#b91c1c;font-weight:600;"><%= money(a.overcost) %></td>
            </tr>
          <% end %>
        </table>
      </div>
    <% end %>
  </td></tr>

  <%# El criterio sí se queda: quien recibe esto no siempre entra al panel, donde está
      explicado. Pero completo y en una línea, no repartido y a medias. %>
  <tr><td style="padding:8px 28px 24px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
    Se avisa cuando el precio sube más de <%= PriceAlertDetector::CHANGE_PCT.round %>% sobre la
    mediana del último año, la compra cuesta de más al menos
    <%= money(PriceAlertDetector::MIN_OVERCOST) %> y el insumo mueve
    <%= money(PriceAlertDetector::MIN_SPEND) %> al año. Precios netos, sin IVA.
    <% if @alerts.any?(&:key_ingredient?) %>
      <br>Los insumos clave avisan con su propio umbral, sin esos mínimos de dinero.
    <% end %>
  </td></tr>

</table>
</td></tr></table>
</body></html>
