<%# Aviso de saltos de precio. CSS en línea: los clientes de correo no cargan hojas externas. %>
<% td = "padding:8px 6px;border-bottom:1px solid #f0f1f3;" %>
<% tdr = td + "text-align:right;" %>
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title>Alerta de precios</title></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">

  <tr><td style="background:#92400e;color:#ffffff;padding:20px 28px;">
    <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.8;">🍕 <%= @name %></div>
    <div style="font-size:22px;font-weight:600;margin-top:4px;">
      <%= @alerts.size == 1 ? "Un insumo subió de precio" : "#{@alerts.size} insumos subieron de precio" %>
    </div>
  </td></tr>

  <tr><td style="padding:20px 28px 8px;">
    <p style="margin:0 0 14px;color:#374151;">
      <%= @alerts.size == 1 ? "Esta compra salió" : "Estas compras salieron" %>
      bastante por encima de lo que se venía pagando. El total de sobrecosto es
      <strong><%= money(@alerts.sum { |a| a.overcost.to_f }) %></strong>.
    </p>

    <% @alerts.each do |a| %>
      <div style="border:1px solid #e5e7eb;border-left:4px solid #b91c1c;border-radius:6px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:16px;font-weight:600;"><%= a.ingredient_name %></div>
        <div style="font-size:13px;color:#6b7280;margin-bottom:8px;">
          Comprado el <%= a.purchased_on.strftime("%d/%m/%Y") %>
          <% if a.provider_name.present? %>a <%= a.provider_name %><% end %>
        </div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
          <tr>
            <td style="<%= td %>color:#6b7280;">Se venía pagando</td>
            <td style="<%= tdr %>"><%= money(a.baseline_price) %> / <%= a.unit_label %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Esta compra</td>
            <td style="<%= tdr %>"><strong><%= money(a.new_price) %> / <%= a.unit_label %></strong>
              <%= price_pct_inline(a.new_price.to_f, a.baseline_price.to_f) %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Cantidad comprada</td>
            <td style="<%= tdr %>"><%= number_with_precision(a.quantity, precision: 2, delimiter: ".", separator: ",") %> <%= a.unit_label %></td>
          </tr>
          <tr>
            <td style="<%= td %>color:#6b7280;">Costó de más</td>
            <td style="<%= tdr %>color:#b91c1c;font-weight:600;"><%= money(a.overcost) %></td>
          </tr>
        </table>
      </div>
    <% end %>
  </td></tr>

  <tr><td style="padding:8px 28px 24px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
    El precio de referencia es la mediana de lo pagado por ese insumo en el último año,
    sin contar las líneas mal cargadas. Precios netos, sin IVA.
    Solo se avisa de insumos que pesan en el gasto anual y cuando el sobrecosto supera
    <%= money(PriceAlertDetector::MIN_OVERCOST) %>.
  </td></tr>

</table>
</td></tr></table>
</body></html>
