<% d = @m.day %><% ly = @m.ly_day %><% wd = plural_weekday(@m.report_date).capitalize %>
<%= @name %> — Informe de ventas — <%= long_date(@m.report_date) %>

Venta bruta: <%= money(d&.total) %> | Venta neta (sin IVA): <%= money(d&.net) %> | Tickets: <%= int(d&.tickets) %> | Ticket promedio: <%= money(d&.avg_ticket) %>
Comensales: <%= int(d&.people) %> | Ticket por persona: <%= money(d&.avg_per_person) %> | Propinas: <%= money(d&.tips) %>

Año anterior (<%= long_date(@m.ly_date) %>):
  Venta bruta <%= money(ly&.total) %> (<%= pct_text(d&.total, ly&.total) %>) | Venta neta <%= money(ly&.net) %> (<%= pct_text(d&.net, ly&.net) %>)
  Tickets <%= int(ly&.tickets) %> (<%= pct_text(d&.tickets, ly&.tickets) %>) | Ticket promedio <%= money(ly&.avg_ticket) %> (<%= pct_text(d&.avg_ticket, ly&.avg_ticket) %>)
  Comensales <%= int(ly&.people) %> (<%= pct_text(d&.people, ly&.people) %>) | Ticket por persona <%= money(ly&.avg_per_person) %> (<%= pct_text(d&.avg_per_person, ly&.avg_per_person) %>)

Acumulados:
<% @m.periods.each do |p| %>  <%= p.label %>: <%= money(p.current.total) %> vs. <%= money(p.ly.total) %> el año anterior (<%= pct_text(p.current.total, p.ly.total) %>) — ticket por persona <%= money(p.current.avg_per_person) %> (<%= pct_text(p.current.avg_per_person, p.ly.avg_per_person) %>)
<% if (aviso = weekday_gap_note(p)) %>    Ojo: <%= aviso %>
<% end %><% end %>
Comparativa de todos los años (1 ene → <%= @m.report_date.strftime("%d/%m") %>):
<% @m.years.each_with_index do |y, i| %><% prev = @m.years[i + 1]&.ytd %>  <%= y.year %>: <%= money(y.ytd.total) %> (<%= pct_text(y.ytd.total, prev&.total) %>) — <%= int(y.ytd.tickets) %> tickets, ticket por persona <%= money(y.ytd.avg_per_person) %><%= y.complete ? " — año completo: #{money(y.full.total)}" : "" %>
<% end %>
Venta promedio diaria:
  <%= @m.report_date.year %> (1 ene → hoy): <%= money(@m.ytd.avg_total) %> — hoy vs. promedio: <%= pct_text(d&.total, @m.ytd.avg_total) %>
  <%= @m.report_date.year - 1 %>, mismo período: <%= money(@m.ly_same_period.avg_total) %> — hoy vs. promedio: <%= pct_text(d&.total, @m.ly_same_period.avg_total) %>
  <%= @m.report_date.year - 1 %> completo: <%= money(@m.ly_full.avg_total) %> — hoy vs. promedio: <%= pct_text(d&.total, @m.ly_full.avg_total) %>

Mismo día de la semana (<%= weekday_name(@m.report_date).downcase %>):
  <%= wd %> de <%= @m.report_date.year %> (sin hoy): <%= money(@m.weekday_ytd.avg_total) %> (<%= @m.weekday_ytd.days %> días) — hoy vs. promedio: <%= pct_text(d&.total, @m.weekday_ytd.avg_total) %>
  <%= wd %> de <%= @m.report_date.year - 1 %>: <%= money(@m.weekday_ly.avg_total) %> (<%= @m.weekday_ly.days %> días) — hoy vs. promedio: <%= pct_text(d&.total, @m.weekday_ly.avg_total) %>
