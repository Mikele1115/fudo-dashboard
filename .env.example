# ===== Fudo =====
# Credenciales de la "API de propósito general" (Fudo > Administración > Usuarios > usuario API)
FUDO_API_KEY=
FUDO_API_SECRET=

# ===== Restaurante =====
RESTAURANT_NAME=Mi Restaurante
# Zona horaria IANA. Ej: America/Santiago, America/Argentina/Buenos_Aires, America/Mexico_City, America/Bogota, America/Lima
TZ_NAME=America/Santiago
# Hora a la que "cierra" el día de negocio. 0 = medianoche. Si el local cierra a las 2 AM y quieres
# que esas ventas cuenten para el día anterior, pon 4 (el día va de 04:00 a 03:59 del día siguiente).
BUSINESS_DAY_CUTOFF_HOUR=0
# Cómo comparar con el año anterior:
#   weekday = mismo día de la semana del año pasado (D - 364 días). Recomendado para restaurantes.
#   date    = misma fecha calendario del año pasado.
COMPARE_MODE=weekday
# Formato de moneda
CURRENCY_SYMBOL=$
DECIMALS=0
# Días recientes que se vuelven a descargar en cada sincronización (por ventas cerradas tarde o correcciones)
REFRESH_DAYS=3
# IVA incluido en el total cobrado (para calcular la venta neta). Chile: 0.19
VAT_RATE=0.19
# Desde qué fecha descargar el histórico (todos los años que quieres comparar en el dashboard).
# La primera venta de la cuenta se puede ver en Fudo > Ventas. Por defecto: 1 de enero del año anterior.
HISTORY_FROM=2019-01-01

# ===== Correo (SMTP) =====
# Para Gmail: activa verificación en 2 pasos y crea una "Contraseña de aplicación" en
# https://myaccount.google.com/apppasswords . NO uses tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Varios destinatarios separados por coma
MAIL_TO=

# ===== Producción (opcional) =====
# Si corres el servidor en modo producción, esto hace que Puma ejecute también los jobs
# programados (informe diario a las 00:00 definido en config/recurring.yml).
# SOLID_QUEUE_IN_PUMA=true
# SECRET_KEY_BASE=
